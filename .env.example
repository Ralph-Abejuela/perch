# Copy to .env and adjust. Everything works with defaults for local dev.

# REQUIRED in production: a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
PERCH_JWT_SECRET=dev-secret-change-me

# Dashboard origin(s) allowed to call the API (comma-separated).
# Example for Cloudflare Pages demo: https://perch-demo.pages.dev
PERCH_CORS_ORIGINS=http://localhost:5173

# If dashboard and API are on different registrable domains, use:
# PERCH_COOKIE_SAMESITE=none
# PERCH_COOKIE_SECURE=true

# Optional Cloudflare Tunnel
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...
